<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".XiaomanApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Xiaoman"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App Shortcuts：记一条 / 写情书 / 抽一张 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="xiaoman" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- ── 新一代桌面小工具（docs/prototype/widgets.html · 8 个）── -->

        <!-- ① 恋爱计时 2×2 -->
        <receiver
            android:name=".widget.DayCounterWidget"
            android:exported="false"
            android:label="小满 · 恋爱计时">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_day_counter_info" />
        </receiver>

        <!-- ② 见面倒计时 2×2 -->
        <receiver
            android:name=".widget.MeetCountdownWidget"
            android:exported="false"
            android:label="小满 · 见面倒计时">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_meet_countdown_info" />
        </receiver>

        <!-- ③ 心情打卡 2×2 -->
        <receiver
            android:name=".widget.MoodCheckWidget"
            android:exported="false"
            android:label="小满 · 心情打卡">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mood_info" />
        </receiver>

        <!-- ④ 情话小卡 2×2 -->
        <receiver
            android:name=".widget.LoveQuoteSmallWidget"
            android:exported="false"
            android:label="小满 · 情话小卡">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quote_small_info" />
        </receiver>

        <!-- ⑤ 每日情话 4×2 -->
        <receiver
            android:name=".widget.LoveQuoteWideWidget"
            android:exported="false"
            android:label="小满 · 每日情话">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quote_wide_info" />
        </receiver>

        <!-- ⑥ 快速记一笔 4×1 -->
        <receiver
            android:name=".widget.QuickMemoWidget"
            android:exported="false"
            android:label="小满 · 快速记一笔">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_memo_info" />
        </receiver>

        <!-- ⑦ 雨过翻一篇 4×1 -->
        <receiver
            android:name=".widget.RainPassWidget"
            android:exported="false"
            android:label="小满 · 雨过翻一篇">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_rain_info" />
        </receiver>

        <!-- ⑧ 相伴大卡 4×3 -->
        <receiver
            android:name=".widget.ComboWidget"
            android:exported="false"
            android:label="小满 · 相伴">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_combo_info" />
        </receiver>

        <!-- 心情打卡无界面写库回调 -->
        <receiver
            android:name=".widget.MoodActionReceiver"
            android:exported="false" />

        <!-- 情话「换一句」回调 -->
        <receiver
            android:name=".widget.QuoteRefreshReceiver"
            android:exported="false" />
    </application>
</manifest>
