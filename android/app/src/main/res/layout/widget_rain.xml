<?xml version="1.0" encoding="utf-8"?>
<!-- ⑦ 雨过翻一篇 4×1
     一行高的入口卡：左「云」圆标 26dp（图标 12dp）→ 文案两行（12sp 粗体 + 10sp 次级）
     → 右侧 chevron 10dp。图标/文字/箭头三者垂直居中，间距 4/6/8 三档。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/w_board_slim2"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <FrameLayout
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="@drawable/w_circle_q">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="center"
            android:src="@drawable/w_ic_cloud"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_rain_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="雨过 · 翻一篇"
            android:textColor="@color/w_ink"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/w_rain_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="把不开心翻篇，继续晴"
            android:textColor="@color/w_ink2"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/w_ic_chevron"
        android:contentDescription="@null" />
</LinearLayout>
