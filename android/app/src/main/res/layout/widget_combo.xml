<?xml version="1.0" encoding="utf-8"?>
<!-- ⑧ 相伴大卡 3×3（顶栏 + 引文 + 四入口）
     配色收敛（v1.6.4）：
       原来引文是一块 55% 面积的粉底 + 绛红字 + 蓝色「距见面」胶囊 → 粉、红、蓝三色打架。
       现在引文**不加底色**，改成引用块样式：左侧一道 2dp accent 竖线、正文用墨色；
       胶囊改暖米底 + 次级墨。四入口统一暖米底 + 墨色标签，颜色只留给 11dp 图标。
     字号：顶栏「第/天」11sp、天数 14sp 粗体；引文 12sp；入口标签 11sp（不再 10sp）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/w_cb_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/w_board_big"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/w_cb_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/w_face_her"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:text=""
                android:textSize="1sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="第"
                android:textColor="@color/w_ink2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/w_cb_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_marginHorizontal="3dp"
                android:text="1268"
                android:textColor="@color/w_ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="天"
                android:textColor="@color/w_ink2"
                android:textSize="11sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:text=""
                android:textSize="1sp" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/w_face_him"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- 引文：左侧 2dp accent 竖线 + 正文（竖线只跟正文等高，不再拉到胶囊那一行） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:background="@color/w_accent"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/w_cb_quote"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:gravity="center_vertical"
                android:maxLines="3"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:text="我走过许多地方的路，行过许多地方的桥，却只爱过一个正当最好年龄的人。"
                android:textColor="@color/w_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 见面胶囊 + 换一句：左内距 12dp，与正文左边缘对齐 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/w_cb_meet_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/w_pill_him"
                android:paddingHorizontal="7dp"
                android:paddingVertical="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="距见面 23 天"
                android:textColor="@color/w_ink2"
                android:textSize="11sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:text=""
                android:textSize="1sp" />

            <LinearLayout
                android:id="@+id/w_cb_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="0dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/w_ic_refresh"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="换一句"
                    android:textColor="@color/w_accent"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_cb_tiles"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:id="@+id/w_cb_write"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/w_act_accent_bg">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/w_ic_edit"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:text="日记"
                    android:textColor="@color/w_ink"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/w_cb_mood"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/w_act_gold_bg">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/w_ic_heart_gold"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:text="心情"
                    android:textColor="@color/w_ink"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/w_cb_draw"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/w_act_her_bg">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/w_ic_quote"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:text="情话"
                    android:textColor="@color/w_ink"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/w_cb_rain"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/w_act_q_bg">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/w_ic_cloud"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:text="雨过"
                    android:textColor="@color/w_ink"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
