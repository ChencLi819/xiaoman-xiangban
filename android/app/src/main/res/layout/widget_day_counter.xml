<?xml version="1.0" encoding="utf-8"?>
<!-- ① 恋爱计时 2×2
     外层 FrameLayout 铺满格子并居中卡片；内层卡片在 Android 12+
     由代码按实例实际尺寸取 min(宽,高) 定成正方形，旧系统回退铺满。
     数字与单位字号按实例边长等比微调（见 XmWidgets.fitScale）。
     排版：数字行靠 baselineAligned 对齐（不再用 marginBottom 假基线）；
     下方说明居中且宽约 58dp，落在底图两枚插画（各占短边 16%）中间的安全带里。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/w_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/w_board_square"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_dc_unit_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="第"
                android:textColor="@color/w_ink2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/w_dc_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_marginHorizontal="3dp"
                android:text="1268"
                android:textColor="@color/w_accent"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_dc_unit_r"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="天"
                android:textColor="@color/w_ink2"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_dc_cap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="自 2023.03.14"
            android:textColor="@color/w_ink3"
            android:textSize="11sp"
            android:letterSpacing="0.02" />
    </LinearLayout>
</FrameLayout>
