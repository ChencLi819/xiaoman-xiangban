<?xml version="1.0" encoding="utf-8"?>
<!-- ⑬ 点滴 4×2（v1.5 六件套，v1.6.7 恢复）
     最近三条（别人的「仅我看」不显示，与 App 内一致）。
     三行居中容器 + 底部次按钮；空行由 setTextOrHide 收成 GONE，
     不再留 17dp 空档。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/w_board_wide"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="点滴 · 最近"
            android:textColor="@color/w_ink"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/w_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="0 条"
            android:textColor="@color/w_ink2"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/w_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="还没有记录"
            android:textColor="@color/w_ink"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/w_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text=""
            android:textColor="@color/w_ink"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/w_row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text=""
            android:textColor="@color/w_ink"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_action"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/w_btn_soft"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:text="＋ 记一条"
        android:textColor="@color/w_accent"
        android:textSize="11sp" />
</LinearLayout>
