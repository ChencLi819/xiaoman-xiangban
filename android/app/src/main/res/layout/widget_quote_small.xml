<?xml version="1.0" encoding="utf-8"?>
<!-- ④ 情话小卡 2×2
     外层 FrameLayout 铺满格子并居中卡片；内层卡片在 Android 12+
     由代码按实例实际尺寸取 min(宽,高) 定成正方形，旧系统回退铺满。
     层级修正（v1.6.2）：引号与「换一句」同处顶栏（刷新动作就该在顶部），
     正文独占中段并垂直居中。底图左下插画占着底部，所以底部不再放任何文字
     （原来「每日情话」小标正好压在她头上）。
     正文行数按边长由代码定（小卡 2 行 / 大卡 3 行）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/w_qs_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/w_board_square"
        android:padding="16dp">

        <!-- 顶栏只放动作：换一句（引号跟正文成组，见下） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:text=""
                android:textSize="1sp" />

            <LinearLayout
                android:id="@+id/w_qs_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="0dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/w_ic_refresh"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="换一句"
                    android:textColor="@color/w_accent"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 引号 + 正文成组垂直居中：上下留白对称，卡片重心落在中间 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/w_qs_mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="“"
                android:textColor="@color/w_accent"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_qs_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="top"
                android:maxLines="3"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:text="世界上最好的，就是你。"
                android:textColor="@color/w_ink"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
