<?xml version="1.0" encoding="utf-8"?>
<!-- ⑤ 每日情话 4×2
     与 2×2 情话小卡同一套层级：顶栏「引号 + 换一句」→ 正文（垂直居中）→
     页脚小标「每日情话 · N 条精选」。原来「引号」独占一行、下方再空 8dp，
     正文被压到中段，页脚又贴在最底，整张卡重心散开。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/w_board_wide"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="“"
            android:textColor="@color/w_accent"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:text=""
            android:textSize="1sp" />

        <LinearLayout
            android:id="@+id/w_qw_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="0dp"
            android:paddingBottom="2dp">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/w_ic_refresh"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="换一句"
                android:textColor="@color/w_accent"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_qw_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:text="我走过许多地方的路，行过许多地方的桥，却只爱过一个正当最好年龄的人。"
        android:textColor="@color/w_ink"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/w_qw_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="每日情话 · 109 条精选"
        android:textColor="@color/w_ink3"
        android:textSize="11sp"
        android:letterSpacing="0.03" />
</LinearLayout>
